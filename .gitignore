# deps
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# next
.next/
out/
dist/
build/
*.tsbuildinfo

# env & secrets
.env
.env.local
.env.*.local
.api_keys.json
*_session.json
*cookies.json

# db & data - the database never enters version control
*.db
*.db-shm
*.db-wal
infra/db/*
!infra/db/.gitkeep

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
farm-events-*.jsonl

# os
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# desktop shell (apps/desktop) build artifacts
apps/desktop/dist
apps/desktop/release
apps/desktop/node_modules
# generated resource copies (scripts/prepare-resources.js)
apps/desktop/standalone/
apps/desktop/farm/
# keep the icon (electron-builder buildResources) despite the bare build/ rule above
!apps/desktop/build/

