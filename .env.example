# Octagon - environment template. Copy to .env and fill in your own values.
# Everything runs locally; no cloud services, no login, no accounts.

# --- Database (local SQLite file, created on first run) ---
# The built-in default (repo_root/infra/db/farm.db) works out of the box.
# Set this only for a custom location. A relative path resolves from
# apps/dashboard, so prefer an absolute path.
# FARM_DB_PATH=/absolute/path/to/farm.db

# --- Farm nodes ---
# Voice prefix is what the Mac says and the iPhone's Voice Control custom
# command listens for. UDIDs are optional; used by screen capture (MCP tool).
FARM_PHONE1_PREFIX=Alpha
FARM_PHONE2_PREFIX=Bravo
FARM_PHONE3_PREFIX=Charlie
FARM_PHONE4_PREFIX=Delta
FARM_PHONE1_UDID=
FARM_PHONE2_UDID=
FARM_PHONE3_UDID=
FARM_PHONE4_UDID=
