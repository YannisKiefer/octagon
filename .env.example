# Octagon - environment template. Copy to .env and fill in your own values.
# Everything runs locally; no cloud services are required or contacted.

# --- Dashboard auth (NextAuth) ---
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=change-me
# Optional second, read-only account:
DASHBOARD_VIEWER_USER=viewer
DASHBOARD_VIEWER_PASSWORD=change-me

# --- Database (local SQLite file, created on first run) ---
FARM_DB_PATH=./infra/db/farm.db

# --- Farm nodes ---
# Voice prefix is what the Mac says and the iPhone's Voice Control custom
# command listens for. UDIDs are optional; used by screen capture (MCP tool).
FARM_PHONE1_PREFIX=Alpha
FARM_PHONE2_PREFIX=Bravo
FARM_PHONE3_PREFIX=Charlie
FARM_PHONE4_PREFIX=Delta
FARM_PHONE1_UDID=
FARM_PHONE2_UDID=
FARM_PHONE3_UDID=
FARM_PHONE4_UDID=
