# Phone Farm OS — Environment Template
# Copy to .env and fill with your own values

# --- Dashboard Auth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=change-me
DASHBOARD_VIEWER_USER=viewer
DASHBOARD_VIEWER_PASSWORD=change-me

# --- Database ---
FARM_DB_PATH=./infra/db/farm.db
# legacy fallback — kept for compat
OCTRAGON_DB_PATH=./infra/db/farm.db

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_GROUP_PHONE1=
TELEGRAM_GROUP_PHONE2=
TELEGRAM_GROUP_PHONE3=
TELEGRAM_GROUP_PHONE4=

# --- AI ---
GEMINI_API_KEY=
OPENAI_API_KEY=
TELETHON_API_ID=
TELETHON_API_HASH=

# --- Payments (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_ENTERPRISE=

# --- Farm Nodes ---
FARM_PHONE1_PREFIX=Alpha
FARM_PHONE2_PREFIX=Bravo
FARM_PHONE3_PREFIX=Charlie
FARM_PHONE4_PREFIX=Delta
FARM_PHONE1_UDID=
FARM_PHONE2_UDID=
FARM_PHONE3_UDID=
FARM_PHONE4_UDID=

# --- Social handles (optional) ---
TIKTOK_PHONE1=@your_handle_1
TIKTOK_PHONE2=@your_handle_2
TIKTOK_PHONE3=@your_handle_3
TIKTOK_PHONE4=@your_handle_4
INSTAGRAM_PHONE1=@your_handle_1
INSTAGRAM_PHONE2=@your_handle_2
INSTAGRAM_PHONE3=@your_handle_3
INSTAGRAM_PHONE4=@your_handle_4
